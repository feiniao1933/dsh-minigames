{
  "name": "dsh-minigames",
  "version": "1.0.0",
  "description": "Mini games box for the DSH right sidebar: Gomoku human vs AI with easy/normal/hard difficulty, placement sounds and a victory celebration.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "gomoku",
    "five-in-a-row",
    "minigames",
    "game",
    "sidebar",
    "web-ui"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Poboy <feiniao1933@gmail.com>",
  "homepage": "https://github.com/feiniao1933/dsh-minigames#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feiniao1933/dsh-minigames.git"
  },
  "bugs": {
    "url": "https://github.com/feiniao1933/dsh-minigames/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/*.js",
    "build.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
